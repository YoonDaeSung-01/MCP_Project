# ==========================================
# Learning App Backend Environment Configuration
# ==========================================
# 이 파일을 복사하여 .env 파일을 만들고 실제 값을 설정하십시오.
# .env 파일은 Git 및 외부 배포에서 제외됩니다.

# ------------------------------------------
# Gemini Model API 설정
# ------------------------------------------
# Google AI Studio 또는 Google Cloud에서 발급받은 API Key
GEMINI_API_KEY=your_gemini_api_key_here

# 사용할 기본 Gemini 모델 식별자 (초기값: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------
# App 저장소 및 실행 환경 설정
# ------------------------------------------
# 사용자 데이터베이스(SQLite) 및 백업이 저장되는 로컬 경로
# 기본값: Windows의 %LOCALAPPDATA%/MCP_project
APP_DATA_DIR=C:/Users/username/AppData/Local/MCP_project

# 기본 시간대 (기본값: Asia/Seoul)
APP_TIMEZONE=Asia/Seoul

# 서버 바인딩 호스트 및 포트 (기본값: 127.0.0.1 / 8000)
HOST=127.0.0.1
PORT=8000

# CORS 허용 Origin 목록 (쉼표로 구분)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ------------------------------------------
# Wiki Root Directory 설정 (읽기 전용 연결)
# ------------------------------------------
# 기존 Markdown Vault의 Collection별 절대 경로를 지정합니다.
WIKI_ROOT_AI_TERMS=C:/Users/username/OneDrive/Desktop/workspace/Cowork-HQ/20_Vault/AI-IT용어
WIKI_ROOT_AI_USAGE=C:/Users/username/OneDrive/Desktop/workspace/Cowork-HQ/20_Vault/AI-IT활용
WIKI_ROOT_ALGORITHMS=C:/Users/username/OneDrive/Desktop/workspace/Cowork-HQ/20_Vault/알고리즘

# ------------------------------------------
# 실행 제한 설정 (ARCHITECTURE.md §12)
# ------------------------------------------
TURN_TIMEOUT_SECONDS=120
TURN_MAX_MODEL_CALLS=4
TURN_MAX_TOOL_CALLS=8
MAX_INPUT_CHARS=60000
MAX_OUTPUT_TOKENS=4096
WIKI_SEARCH_DEFAULT_LIMIT=10
WIKI_SEARCH_MAX_LIMIT=20
WIKI_READ_MAX_CHARS=12000
