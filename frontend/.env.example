# ==========================================
# Learning App Frontend Environment Configuration
# ==========================================
# 이 파일을 복사하여 .env 파일을 만들고 필요한 경우 값을 변경하십시오.

# Backend API 기본 주소 (기본값: vite.config.ts의 프록시를 사용할 경우 비워둠)
# 직접 연결 시: http://127.0.0.1:8000
VITE_API_BASE_URL=

# App 개발 서버 포트 (기본값: 5173)
VITE_DEV_PORT=5173
